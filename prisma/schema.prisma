// ---------------------------------------------------------------------------
// Job Email Extractor — Prisma schema
// PostgreSQL. Normalized design:
//   - NextAuth models: User, Account, Session, VerificationToken
//   - Domain models:   UserSettings, SyncState, Company, Template,
//                      Recipient (deduped aggregate), EmailMessage (history)
// ---------------------------------------------------------------------------

generator client {
  provider      = "prisma-client-js"
  // "native" for local dev; the musl target is required by the Alpine Docker images.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Authentication (NextAuth / @auth/prisma-adapter)
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]

  settings      UserSettings?
  syncState     SyncState?
  companies     Company[]
  templates     Template[]
  recipients    Recipient[]
  messages      EmailMessage[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String? @db.Text
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Per-user application settings
// ---------------------------------------------------------------------------

enum Theme {
  LIGHT
  DARK
  SYSTEM
}

model UserSettings {
  id                   String   @id @default(cuid())
  userId               String   @unique
  theme                Theme    @default(SYSTEM)
  syncIntervalMinutes  Int      @default(60)
  batchSize            Int      @default(100)
  maxEmails            Int      @default(0) // 0 = unlimited
  exportDir            String   @default("./exports")
  autoSyncEnabled      Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Incremental sync bookkeeping (one row per user)
// ---------------------------------------------------------------------------

enum SyncStatus {
  IDLE
  RUNNING
  COMPLETED
  FAILED
}

model SyncState {
  id                String     @id @default(cuid())
  userId            String     @unique
  status            SyncStatus @default(IDLE)
  // Gmail history cursor for incremental sync.
  lastHistoryId     String?
  // Epoch millis of the most recent processed sent message (query fallback).
  lastMessageEpoch  BigInt?
  lastSyncStartedAt DateTime?
  lastSyncEndedAt   DateTime?
  totalScanned      Int        @default(0)
  processedInRun    Int        @default(0)
  errorMessage      String?    @db.Text
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Companies (inferred from recipient domains)
// ---------------------------------------------------------------------------

model Company {
  id         String   @id @default(cuid())
  userId     String
  name       String
  domain     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipients Recipient[]
  messages   EmailMessage[]

  @@unique([userId, domain])
  @@index([userId])
  @@index([userId, name])
}

// ---------------------------------------------------------------------------
// Templates (grouped by body similarity)
// ---------------------------------------------------------------------------

model Template {
  id             String   @id @default(cuid())
  userId         String
  name           String
  // Normalized representative text used for similarity comparison.
  normalizedText String   @db.Text
  // Deterministic fingerprint (hash of normalized text) for fast lookups.
  fingerprint    String
  sampleSubject  String?  @db.Text
  sampleBodyText String?  @db.Text
  emailCount     Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipients Recipient[]
  messages   EmailMessage[]

  @@index([userId])
  @@index([userId, fingerprint])
}

// ---------------------------------------------------------------------------
// Recipient — the DEDUPED record. Exactly one per (user, email).
// ---------------------------------------------------------------------------

model Recipient {
  id               String   @id @default(cuid())
  userId           String
  email            String
  companyId        String?
  latestTemplateId String?

  firstSentAt      DateTime
  lastSentAt       DateTime
  sentCount        Int      @default(0)

  latestSubject    String?  @db.Text
  latestBodyText   String?  @db.Text
  latestBodyHtml   String?  @db.Text

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  company        Company?       @relation(fields: [companyId], references: [id], onDelete: SetNull)
  latestTemplate Template?      @relation(fields: [latestTemplateId], references: [id], onDelete: SetNull)
  messages       EmailMessage[]

  @@unique([userId, email])
  @@index([userId])
  @@index([userId, companyId])
  @@index([userId, lastSentAt])
  @@index([userId, email])
}

// ---------------------------------------------------------------------------
// EmailMessage — one row per sent Gmail message (the history / audit trail).
// ---------------------------------------------------------------------------

model EmailMessage {
  id             String   @id @default(cuid())
  userId         String
  gmailMessageId String
  threadId       String?
  historyId      String?

  recipientId    String?
  recipientEmail String
  companyId      String?
  templateId     String?

  subject        String?  @db.Text
  bodyText       String?  @db.Text
  bodyHtml       String?  @db.Text

  sentAt         DateTime

  createdAt      DateTime @default(now())

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipient Recipient? @relation(fields: [recipientId], references: [id], onDelete: SetNull)
  company   Company?   @relation(fields: [companyId], references: [id], onDelete: SetNull)
  template  Template?  @relation(fields: [templateId], references: [id], onDelete: SetNull)

  // A message may have multiple recipients; one row per (message, recipient).
  // The gmailMessageId alone still lets us detect already-processed messages.
  @@unique([userId, gmailMessageId, recipientEmail])
  @@index([userId])
  @@index([userId, gmailMessageId])
  @@index([userId, sentAt])
  @@index([userId, recipientEmail])
  @@index([userId, templateId])
  @@index([userId, companyId])
}
