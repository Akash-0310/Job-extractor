# ---------------------------------------------------------------------------
# Job Email Extractor — Environment Variables
# Copy this file to `.env` and fill in the values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# --- Database (PostgreSQL) --------------------------------------------------
# When running the app on the host and Postgres in Docker, host is localhost.
# Inside docker-compose the host is the service name `postgres`.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/job_email_extractor?schema=public"

# --- Redis (BullMQ background jobs) -----------------------------------------
# Inside docker-compose the host is the service name `redis`.
REDIS_URL="redis://localhost:6379"

# --- NextAuth ---------------------------------------------------------------
# Generate a strong secret: `openssl rand -base64 32`
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# --- Google OAuth (Gmail API) -----------------------------------------------
# Create these in Google Cloud Console → APIs & Services → Credentials.
# See docs/GOOGLE_OAUTH_SETUP.md for the full walkthrough.
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# --- Application ------------------------------------------------------------
NODE_ENV="development"
LOG_LEVEL="info"

# Default export directory (used by the worker for scheduled exports).
EXPORT_DIR="./exports"

# Default sync tuning (can be overridden per-user in Settings).
DEFAULT_BATCH_SIZE="100"
DEFAULT_SYNC_INTERVAL_MINUTES="60"
DEFAULT_MAX_EMAILS="0" # 0 = unlimited
